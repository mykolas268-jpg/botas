# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env - it contains secrets.

# --- Required ---------------------------------------------------------------
# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token-here

# Channel the daily digest is posted to.
# Discord: User Settings -> Advanced -> Developer Mode ON, then right-click channel -> Copy Channel ID
DISCORD_CHANNEL_ID=123456789012345678

# --- Optional ---------------------------------------------------------------
# NewsAPI.org key (free "Developer" plan). Leave empty to skip NewsAPI entirely.
NEWSAPI_KEY=your-newsapi-key-here

# Daily post time and timezone (IANA name, e.g. Europe/Vilnius, Europe/London)
DIGEST_HOUR=8
DIGEST_MINUTE=0
TIMEZONE=Europe/Vilnius

# Ignore articles older than this many hours (stops week-old feed items appearing)
MAX_ARTICLE_AGE_HOURS=36

# SQLite file location (default: digest.db next to bot.py)
# DB_PATH=/data/digest.db
